    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F4" sourceRef="Accept" targetRef="Merge" />
    <bpmn:sequenceFlow id="F5" sourceRef="Reject" targetRef="Merge" />
    <bpmn:sequenceFlow id="F6" sourceRef="Merge" targetRef="End" />
    <bpmn:sequenceFlow id="Flow_0ov532z" sourceRef="Split" targetRef="Accept" />
  </bpmn:process>
