<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="Definitions_Control" targetNamespace="http://example.com/bpmn/control">
  <bpmn:process id="Process_Control" isExecutable="true">
    <bpmn:startEvent id="Start">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Review" name="Review request">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Decision" name="Approved?" default="F4">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
      <bpmn:outgoing>Flow_1lkh9ly</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="robot_run" name="Run Robot task" camunda:type="external" camunda:topic="robot.run">
      <bpmn:incoming>Flow_1lkh9ly</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="robot_notify" name="Notify requester" camunda:type="external" camunda:topic="robot.notify">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Merge">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End">
      <bpmn:incoming>F7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Review" />
    <bpmn:sequenceFlow id="F2" sourceRef="Review" targetRef="Decision" />
    <bpmn:sequenceFlow id="F4" name="no" sourceRef="Decision" targetRef="robot_notify" />
    <bpmn:sequenceFlow id="F5" sourceRef="robot_run" targetRef="Merge" />
    <bpmn:sequenceFlow id="F6" sourceRef="robot_notify" targetRef="Merge" />
    <bpmn:sequenceFlow id="F7" sourceRef="Merge" targetRef="End" />
    <bpmn:sequenceFlow id="Flow_1lkh9ly" name="yes" sourceRef="Decision" targetRef="robot_run" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Process_Control">
    <bpmndi:BPMNPlane id="BPMNPlane_Process_Control" bpmnElement="Process_Control">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start">
        <dc:Bounds x="62" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Review_di" bpmnElement="Review">
        <dc:Bounds x="148" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Decision_di" bpmnElement="Decision" isMarkerVisible="true">
        <dc:Bounds x="298" y="45" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="297" y="25" width="54" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="robot_run_di" bpmnElement="robot_run">
        <dc:Bounds x="398" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="robot_notify_di" bpmnElement="robot_notify">
        <dc:Bounds x="398" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Merge_di" bpmnElement="Merge" isMarkerVisible="true">
        <dc:Bounds x="545" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_di" bpmnElement="End">
        <dc:Bounds x="645" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1">
        <di:waypoint x="98" y="70" />
        <di:waypoint x="148" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2">
        <di:waypoint x="248" y="70" />
        <di:waypoint x="298" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4">
        <di:waypoint x="323" y="95" />
        <di:waypoint x="323" y="210" />
        <di:waypoint x="398" y="210" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="354" y="194" width="13" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5">
        <di:waypoint x="498" y="70" />
        <di:waypoint x="545" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F6_di" bpmnElement="F6">
        <di:waypoint x="498" y="210" />
        <di:waypoint x="570" y="210" />
        <di:waypoint x="570" y="95" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F7_di" bpmnElement="F7">
        <di:waypoint x="595" y="70" />
        <di:waypoint x="645" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1lkh9ly_di" bpmnElement="Flow_1lkh9ly">
        <di:waypoint x="348" y="70" />
        <di:waypoint x="398" y="70" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="364" y="52" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
