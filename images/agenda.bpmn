<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Agenda" targetNamespace="http://example.com/bpmn/agenda">
  <bpmn:process id="Process_Agenda" isExecutable="false">
    <bpmn:startEvent id="Start" name="Start">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="StateActivity" name="State vs. Activities">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="BpmnPrimer" name="BPMN 2.0 Primer">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Ecosystem" name="Ecosystem Overview">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Operaton" name="Plone with Operaton">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End" name="Finish">
      <bpmn:incoming>Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="StateActivity" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="StateActivity" targetRef="BpmnPrimer" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="BpmnPrimer" targetRef="Ecosystem" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Ecosystem" targetRef="Operaton" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Operaton" targetRef="End" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Agenda">
    <bpmndi:BPMNPlane id="BPMNPlane_Agenda" bpmnElement="Process_Agenda">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start">
        <dc:Bounds x="100" y="122" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="104" y="168" width="28" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StateActivity_di" bpmnElement="StateActivity">
        <dc:Bounds x="196" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BpmnPrimer_di" bpmnElement="BpmnPrimer">
        <dc:Bounds x="356" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Ecosystem_di" bpmnElement="Ecosystem">
        <dc:Bounds x="516" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Operaton_di" bpmnElement="Operaton">
        <dc:Bounds x="676" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_di" bpmnElement="End">
        <dc:Bounds x="836" y="122" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="835" y="168" width="38" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="136" y="140" />
        <di:waypoint x="196" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="296" y="140" />
        <di:waypoint x="356" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="456" y="140" />
        <di:waypoint x="516" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="616" y="140" />
        <di:waypoint x="676" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="776" y="140" />
        <di:waypoint x="836" y="140" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
